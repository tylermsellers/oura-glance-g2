{
  "name": "@evenrealities/pretext",
  "version": "0.1.4",
  "description": "Pixel-accurate font measurement library for Even Realities G2 glasses",
  "type": "module",
  "main": "dist/font_measure.js",
  "types": "dist/font_measure.d.ts",
